# 应用基础配置（复制为 .env 后按需修改）
APP_NAME=smart-qa-agent
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Embedding 配置（OpenAI 兼容接口）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=30

# Milvus 配置
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=qa_chunks
MILVUS_TIMEOUT=10
EMBEDDING_BATCH_SIZE=20

# LLM 配置（base_url/api_key 留空则复用 Embedding 配置）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0
LLM_TIMEOUT=30

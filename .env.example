# 应用基础配置（复制为 .env 后按需修改）
APP_NAME=smart-qa-agent
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Embedding 配置（OpenAI 兼容接口）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=30

# Milvus 配置
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=qa_chunks_prod_v3
MILVUS_TIMEOUT=10
EMBEDDING_BATCH_SIZE=20

# LLM 配置（base_url/api_key 留空则复用 Embedding 配置）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0
LLM_TIMEOUT=30

# Rerank API（阿里云百炼 text-rerank，与 Embedding 共用同一把 key 即可）
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TIMEOUT=30
RERANK_MAX_CANDIDATES=30

# Retrieval
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_CANDIDATE_K=50

# Agent
AGENT_MAX_REWRITES=1

# Chunk
CHUNK_STRATEGY=fixed
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LangSmith 全链路追踪（可选）
# 两项都配置后才启用：API_KEY 填你的 key，TRACING 置为 true
# 默认关闭，不发任何网络请求；上报失败不影响问答本身
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-qa-agent
# 国内网络访问慢时可换成官方 agent 网关或代理地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
